  ['CL5:safe-resilient-transport-and-smart-mobility-services-for-passengers-and-goods','HORIZON-CL5-2026-10-D6-01'],
  ['CL5:safe-resilient-transport-and-smart-mobility-services-for-passengers-and-goods','HORIZON-CL5-2026-10-D6-02'],
