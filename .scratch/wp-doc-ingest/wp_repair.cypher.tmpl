// ============================================================================
// @@CLUSTER@@ - work-programme re-ingest, graph side
// Generated by gen_wp_cypher.py from @@MERGED_FILE@@
// Document: @@DOCUMENT@@
// ----------------------------------------------------------------------------
// DO NOT EDIT THIS FILE - edit wp_repair.cypher.tmpl and regenerate.
//
// Two facts about the pipeline drive everything below.
//
//   1. `populate` is MERGE-only. `MERGE (c:Call {id:$id}) SET c += $props`
//      never touches HAS_FUNDED_PROJECT, which is why re-ingesting is cheap and
//      spends no CORDIS quota - but it also means that if a topic's ID CHANGED,
//      populate creates a NEW node and leaves the old one orphaned with all of
//      its CORDIS edges. Ids must therefore be renamed in the graph BEFORE the
//      populate, never after.
//
//   2. MERGE never removes an edge. A call that moves to a different Destination
//      keeps its old HAS_CALL as well, so stale destination membership survives
//      a re-populate and has to be deleted explicitly.
//
// PRINCIPLE: rename, never delete-and-recreate. Relationships attach to nodes,
// not to id values, so `SET c.id = ...` preserves every CORDIS edge.
//
// Run one phase at a time and read each guard - the ACT statements are gated on
// guards a human must check:
//   docker exec -i knowledge-graph-app-dev-neo4j-1 cypher-shell -u neo4j -p password
// cypher-shell prints four JVM "restricted method" WARNINGs on stderr: ignore.
// ============================================================================

// The topics this edition defines (plus portal-only topics kept deliberately).
:param canonical => [
@@CANONICAL_IDS@@
];

// [old id, current id] for every topic whose id changed. Applied to the graph as
// an in-place rename so the CORDIS edges on the old node survive.
:param idRewrites => [
@@ID_REWRITES@@
];

// The destinations this edition defines, as Destination node ids.
:param currentDestinations => [
@@DEST_IDS@@
];

// The authoritative [destination id, call id] membership.
:param membership => [
@@MEMBERSHIP@@
];


// ---------------------------------------------------------------------------
// PHASE 0 - MEASURE (read-only). Write these down.
// ---------------------------------------------------------------------------
MATCH (c:Call {source:'@@SOURCE_TAG@@'}) RETURN count(c) AS calls_before;

MATCH (c:Call {source:'@@SOURCE_TAG@@'})-[r:HAS_FUNDED_PROJECT]->()
RETURN count(DISTINCT c) AS calls_with_evidence, count(r) AS cordis_edges_before;
// ^ PHASE 8 must reproduce cordis_edges_before exactly.

MATCH (d:Destination)-[:HAS_CALL]->(c:Call {source:'@@SOURCE_TAG@@'})
RETURN left(d.name,70) AS destination, count(c) AS calls ORDER BY calls DESC;


// ---------------------------------------------------------------------------
// PHASE 1 - empty twins. Only relevant if a populate already ran with the NEW
// ids while the graph still held the old ones: that creates an empty duplicate.
// GUARD must return 0. If >0 a twin has CORDIS evidence - STOP and merge by hand
// with apoc.refactor.mergeNodes instead of deleting.
// (No rows at all means there are no twins; skip to phase 2.)
// ---------------------------------------------------------------------------
UNWIND $idRewrites AS rw
MATCH (old:Call {id: rw[0]}), (new:Call {id: rw[1]})
OPTIONAL MATCH (new)-[r:HAS_FUNDED_PROJECT]->()
RETURN count(r) AS twin_evidence_must_be_zero;

// ACT
UNWIND $idRewrites AS rw
MATCH (old:Call {id: rw[0]}), (new:Call {id: rw[1]})
DETACH DELETE new
RETURN count(*) AS twins_deleted;


// ---------------------------------------------------------------------------
// PHASE 2 - rename the surviving originals in place. Keeps every CORDIS edge.
// GUARD must return 0 collisions (no node already holds the target id).
// ---------------------------------------------------------------------------
UNWIND $idRewrites AS rw
OPTIONAL MATCH (x:Call {id: rw[1]})
RETURN count(x) AS collisions_must_be_zero;

// ACT
UNWIND $idRewrites AS rw
MATCH (c:Call {id: rw[0]})
SET c.id = rw[1]
RETURN count(c) AS renamed;


// ---------------------------------------------------------------------------
// PHASE 3 - drop what this edition does not define: portal artefacts (records
// duplicating a topic's title under a less specific id) and leftovers from an
// earlier edition.
// GUARD: review the list. Anything with cordis_evidence > 0 is a judgement call
// and is deliberately NOT deleted by the ACT below.
// ---------------------------------------------------------------------------
MATCH (c:Call {source:'@@SOURCE_TAG@@'}) WHERE NOT c.id IN $canonical
OPTIONAL MATCH (c)-[r:HAS_FUNDED_PROJECT]->()
RETURN c.id AS doomed, left(c.name,60) AS title, count(r) AS cordis_evidence
ORDER BY cordis_evidence DESC, doomed;

// ACT
MATCH (c:Call {source:'@@SOURCE_TAG@@'}) WHERE NOT c.id IN $canonical
  AND NOT EXISTS { MATCH (c)-[:HAS_FUNDED_PROJECT]->() }
DETACH DELETE c
RETURN count(*) AS obsolete_calls_deleted;


// ---------------------------------------------------------------------------
// PHASE 4 - RE-INGEST (outside cypher-shell). Ids are now correct, so populate
// updates the existing nodes instead of creating duplicates.
//
//   python .scratch/wp-doc-ingest/wp_merge.py @@CLUSTER@@ --promote
//   curl -X POST http://localhost:8000@@POPULATE@@
// ---------------------------------------------------------------------------


// ---------------------------------------------------------------------------
// PHASE 5 - make destination membership match the work programme exactly.
// 5a ensures every correct edge, 5b removes every edge that disagrees. Run 5a
// first so no call is ever momentarily parentless.
// ---------------------------------------------------------------------------

// 5a - ensure (no-op if the populate already created them)
UNWIND $membership AS m
MATCH (d:Destination {id: m[0]}), (c:Call {id: m[1]})
MERGE (d)-[:HAS_CALL]->(c)
RETURN count(*) AS edges_ensured;

// 5b - GUARD: what disagrees? Review before deleting.
MATCH (d:Destination)-[r:HAS_CALL]->(c:Call {source:'@@SOURCE_TAG@@'})
WHERE NOT [d.id, c.id] IN $membership
RETURN left(d.name,55) AS wrong_parent, c.id AS call, count(r) AS edges
ORDER BY wrong_parent, call;

// 5b - ACT
MATCH (d:Destination)-[r:HAS_CALL]->(c:Call {source:'@@SOURCE_TAG@@'})
WHERE NOT [d.id, c.id] IN $membership
DELETE r
RETURN count(r) AS stale_edges_deleted;


// ---------------------------------------------------------------------------
// PHASE 6 - delete Destination nodes this edition does not define.
// A Destination's node id is '@@CLUSTER_NODE_ID@@:' + slugified name, so a renamed
// destination becomes a NEW node and the old one lingers with its old calls -
// which is how duplicate destinations appear in the UI after a rename.
// After phase 5b these hold no calls, so this removes only the node and its
// (Cluster)-[:HAS_DESTINATION]-> edge.
// ---------------------------------------------------------------------------
MATCH (d:Destination)
WHERE (d.source = '@@SOURCE_TAG@@' OR d.id STARTS WITH '@@CLUSTER_NODE_ID@@:')
  AND NOT d.id IN $currentDestinations
DETACH DELETE d
RETURN count(*) AS outdated_destinations_deleted;


// ---------------------------------------------------------------------------
// PHASE 7 - repair Call.keywords (free, no API calls).
// The grouped files carry no `keywords` key and _sanitize_props preserves empty
// lists, so `SET c += $props` overwrites CORDIS-written keywords with []. The
// tagger writes related_topics and keywords from the same value, so copy back.
// Root fix: make _build_call_props skip an EMPTY keywords list - conditionally,
// because CEF/CREA/DEP/ERASMUS/EURATOM grouped files DO carry real keywords.
// ---------------------------------------------------------------------------
MATCH (c:Call)
WHERE size(c.related_topics) > 0 AND (c.keywords IS NULL OR size(c.keywords) = 0)
SET c.keywords = c.related_topics
RETURN count(c) AS keywords_restored;


// ---------------------------------------------------------------------------
// PHASE 8 - VERIFY
// ---------------------------------------------------------------------------
MATCH (c:Call {source:'@@SOURCE_TAG@@'}) RETURN count(c) AS calls;   // expect @@CALL_COUNT@@

MATCH (c:Call {source:'@@SOURCE_TAG@@'}) WHERE NOT c.id IN $canonical
RETURN collect(c.id) AS unexpected_must_be_empty;

UNWIND $idRewrites AS rw
OPTIONAL MATCH (c:Call {id: rw[0]})
RETURN count(c) AS old_ids_remaining_must_be_zero;

MATCH (cl:Cluster {id:'@@CLUSTER_NODE_ID@@'})-[:HAS_DESTINATION]->(d:Destination)
OPTIONAL MATCH (d)-[:HAS_CALL]->(c:Call)
RETURN left(d.name,70) AS destination, count(c) AS calls ORDER BY calls DESC;
// expect exactly:
@@DEST_COUNTS@@

// Every call sits under exactly one destination
MATCH (c:Call {source:'@@SOURCE_TAG@@'})
OPTIONAL MATCH (d:Destination)-[:HAS_CALL]->(c)
WITH c, count(d) AS parents
RETURN parents, count(c) AS calls ORDER BY parents;   // expect one row: 1 | @@CALL_COUNT@@

MATCH (c:Call {source:'@@SOURCE_TAG@@'})
RETURN sum(CASE WHEN c.technology_readiness_level IS NOT NULL
                 AND c.technology_readiness_level <> '' THEN 1 ELSE 0 END) AS trl;
// expect @@TRL_COUNT@@

MATCH (c:Call {source:'@@SOURCE_TAG@@'}) WHERE c.status = 'Cancelled'
RETURN collect(c.id) AS cancelled;   // expect @@CANCELLED@@

MATCH (c:Call {source:'@@SOURCE_TAG@@'})-[r:HAS_FUNDED_PROJECT]->()
RETURN count(r) AS cordis_edges_after;   // MUST equal cordis_edges_before

MATCH (cl:Cluster {id:'@@CLUSTER_NODE_ID@@'})-[:HAS_DESTINATION]->(d:Destination)
WHERE d.summary IS NULL OR d.summary = ''
RETURN collect(left(d.name,60)) AS missing_summaries_must_be_empty;
